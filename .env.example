# Copy to .env (gitignored) and fill in. scripts/load-env.sh exports it for
# both Terraform roots (platform/ and tenants/) and every script, with normal
# shell syntax: quote values that contain spaces or special characters.
# Values in .env win over the same variables already set in your shell.

# VCF Automation access: an Organization Administrator's API token for the org.
TF_VAR_vcfa_api_token=
TF_VAR_vcfa_url=https://vcfa.example.com
TF_VAR_vcfa_org=

# Where everything is built.
TF_VAR_region_name=
TF_VAR_zone_name=
TF_VAR_storage_class=                    # e.g. vsan-default-storage-policy
TF_VAR_seg_name=                         # Avi Service Engine Group
TF_VAR_vpc_connectivity_profile=         # e.g. default--<region>

# platform/ only: the vCenter storage policy name for the image library.
TF_VAR_content_library_storage_policy=   # e.g. "vSAN Default Storage Policy"

# tenants/ only: the range the Avi VIPs come from, from the connectivity
# profile's external IP block.
TF_VAR_vip_range=                        # e.g. 10.0.0.41-10.0.0.141

# Optional: the AWX cluster's shape, an HCL object. Unset fields keep their
# defaults in platform/variables.tf.
#TF_VAR_awx_cluster='{ worker_class = "best-effort-large" }'
